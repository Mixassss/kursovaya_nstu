      <height>111</height>
     </rect>
    </property>
    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) switch { выражение }&lt;/p&gt;&lt;p&gt;B) switch (выражение) { case ... }&lt;/p&gt;&lt;p&gt;C) switch [выражение] { case ... }&lt;/p&gt;&lt;p&gt;D) switch (выражение) : { case ... }&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
   <widget class="QLabel" name="fourth_ans">
    <property name="geometry">
