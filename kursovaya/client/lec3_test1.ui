    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) Очередь&lt;/p&gt;&lt;p&gt;        B) Линейный список&lt;/p&gt;&lt;p&gt;        C) Стек&lt;/p&gt;&lt;p&gt;        D) Все вышеперечисленные&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
