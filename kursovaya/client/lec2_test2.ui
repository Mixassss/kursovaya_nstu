      <height>121</height>
     </rect>
    </property>
    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) Они могут быть записаны через запятую.&lt;/p&gt;&lt;p&gt;B) Они выполняются после каждой итерации цикла.&lt;/p&gt;&lt;p&gt;C) Они не обязательны.&lt;/p&gt;&lt;p&gt;D) Все вышеперечисленное&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
