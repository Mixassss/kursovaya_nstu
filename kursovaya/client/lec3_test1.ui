     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) struct Node { int data; };&lt;/p&gt;&lt;p&gt;        B) struct Node { Data d; Node *p; };&lt;/p&gt;&lt;p&gt;        C) struct Node { Data d; };&lt;/p&gt;&lt;p&gt;        D) struct Node { Node *p; };&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
