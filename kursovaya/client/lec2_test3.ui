    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) do { cout &amp;lt;&amp;lt; &amp;quot;Hello&amp;quot;; } while (condition);&lt;/p&gt;&lt;p&gt;B) do operator while (condition);&lt;/p&gt;&lt;p&gt;C) do { cout &amp;lt;&amp;lt; &amp;quot;Hello&amp;quot;; } while (false);&lt;/p&gt;&lt;p&gt;D) Все вышеперечисленные&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
