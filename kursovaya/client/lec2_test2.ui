      <height>121</height>
     </rect>
    </property>
    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) for&lt;/p&gt;&lt;p&gt;B) while&lt;/p&gt;&lt;p&gt;C) do while&lt;/p&gt;&lt;p&gt;D) foreach&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
   <widget class="QLabel" name="fifth_ans">
    <property name="geometry">
     <rect>
      <x>40</x>
      <y>70</y>
