    </property>
    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) Можно создавать объекты структуры сразу после объявления&lt;/p&gt;&lt;p&gt;        B) Можно использовать тип структуры в самой структуре&lt;/p&gt;&lt;p&gt;        C) Можно вызывать методы структуры до ее определения&lt;/p&gt;&lt;p&gt;        D) Можно объявлять указатели на структуру до ее определения&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
