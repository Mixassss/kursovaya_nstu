      <width>451</width>
      <height>111</height>
     </rect>
    </property>
    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) Выполняется блок case с первым значением.&lt;/p&gt;&lt;p&gt;B) Выполняются операторы, расположенные после слова default.&lt;/p&gt;&lt;p&gt;C) Происходит ошибка выполнения.&lt;/p&gt;&lt;p&gt;D) Оператор switch завершается без выполнения.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
