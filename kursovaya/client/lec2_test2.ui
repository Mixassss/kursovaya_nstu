     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) for&lt;/p&gt;&lt;p&gt;B) while&lt;/p&gt;&lt;p&gt;C) do while&lt;/p&gt;&lt;p&gt;D) foreach&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
   <widget class="QLabel" name="ninth_ans">
    <property name="geometry">
     <rect>
      <x>40</x>
      <y>70</y>
      <width>411</width>
      <height>121</height>
     </rect>
    </property>
    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) while (b2) { оператор; b3; }&lt;/p&gt;&lt;p&gt;B) for (b1; b2; b3) { оператор; }&lt;/p&gt;&lt;p&gt;C) do { оператор; } while (b2);&lt;/p&gt;&lt;p&gt;D) if (b2) { оператор; }&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
