      <height>121</height>
     </rect>
    </property>
    <property name="text">
     <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;A) Инициализация&lt;/p&gt;&lt;p&gt;B) Условие выполнения&lt;/p&gt;&lt;p&gt;C) Модификации&lt;/p&gt;&lt;p&gt;D) Все вышеперечисленное&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
    </property>
   </widget>
   <widget class="QLabel" name="third_ans">
